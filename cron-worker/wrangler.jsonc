{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vigorfit-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  // Hourly. Session reminders look 24h ahead and mark themselves sent, and the
  // expiry sweep only warns once per subscription period, so a run that finds
  // nothing to do is free.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // The app is reached through a service binding, not the public internet:
  // Cloudflare refuses a Worker's fetch() to another Worker's workers.dev URL
  // on the same account (error 1042), which silently stopped every reminder.
  "services": [{ "binding": "APP", "service": "vigorfit" }],

  "vars": {
    // Only the path matters through the binding; the host is what the app
    // sees as its own URL.
    "APP_URL": "https://vigorfit.me"
  }

  // CRON_SECRET is a secret, not a var:
  //   npx wrangler secret put CRON_SECRET --config cron-worker/wrangler.jsonc
}
